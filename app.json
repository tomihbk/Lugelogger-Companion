{
  "expo": {
    "name": "Lugelogger Companion",
    "slug": "carmainlogger",
    "version": "1.0.0",
    "scheme": "lugeloggercompanion",
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-dev-launcher",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/HankenGrotesk-Black.ttf",
            "./assets/fonts/HankenGrotesk-BlackItalic.ttf",
            "./assets/fonts/HankenGrotesk-Bold.ttf",
            "./assets/fonts/HankenGrotesk-BoldItalic.ttf",
            "./assets/fonts/HankenGrotesk-Italic.ttf",
            "./assets/fonts/HankenGrotesk-Light.ttf",
            "./assets/fonts/HankenGrotesk-LightItalic.ttf",
            "./assets/fonts/HankenGrotesk-Medium.ttf",
            "./assets/fonts/HankenGrotesk-MediumItalic.ttf",
            "./assets/fonts/HankenGrotesk-Regular.ttf",
            "./assets/fonts/HankenGrotesk-SemiBold.ttf",
            "./assets/fonts/HankenGrotesk-SemiBoldItalic.ttf"
          ]
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#7c2791"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.berinfo.lugeloggercompanion"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#32a852"
      },
      "package": "com.berinfo.lugeloggercompanion"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "9e112d4f-b78c-41c2-9d45-9a33a8db1270"
      }
    },
    "owner": "proteinshaker"
  }
}
